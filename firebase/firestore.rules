// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /locations/{locationId} {
      // Anyone can read upcoming stops (public "Where We'll Be" page).
      allow read: if true;
      // Only signed-in users (mom's admin account) can add/edit/remove stops.
      allow write: if request.auth != null;
    }

    match /inquiries/{inquiryId} {
      // Anyone can submit the public contact form...
      allow create: if true;
      // ...but only signed-in users (mom's admin account) can read or manage
      // submissions — this keeps other people's contact info private.
      allow read, update, delete: if request.auth != null;
    }
  }
}
